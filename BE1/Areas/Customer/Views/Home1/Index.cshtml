@model BE1.Models.viewmodel.HomeProductVM

@{
    ViewBag.Title = "Trang chủ - Lubu Store";
    Layout = "~/Areas/Customer/Views/Shared/_CustomerLayout.cshtml";
}

<style>
    /* --- CSS RIÊNG CHO TRANG CHỦ --- */
    .home-wrap {
        width: 100%;
        overflow: hidden;
        flex: 1;
        background-image: linear-gradient(rgba(255, 255, 255, 0.4), rgba(255, 255, 255, 0.6)), url("/content/image2/5.png");
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        color: #111; /* Chữ mặc định màu đen */
    }

    /* HERO SLIDER (Giữ nguyên nền tối và chữ trắng cho banner) */
    .hero {
        position: relative;
        min-height: 540px;
        background: #0b0b11;
        overflow: hidden;
    }

    .hero-slide {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.8s ease-in-out, visibility 0.8s ease-in-out, transform 1.2s ease;
        background-size: cover;
        background-position: center;
        transform: scale(1.05);
    }

        .hero-slide.active {
            opacity: 1;
            visibility: visible;
            transform: scale(1);
        }

        .hero-slide::before {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(90deg, rgba(7, 7, 15, 0.95) 0%, rgba(8, 8, 18, 0.78) 45%, rgba(8, 8, 18, 0.2) 100%), radial-gradient(circle at 20% 50%, rgba(37, 99, 235, 0.15) 0%, transparent 50%);
        }

    .hero-1 {
        background-image: url('https://images.unsplash.com/photo-1593305841991-05c297ba4575?auto=format&fit=crop&w=1800&q=85');
    }

    .hero-2 {
        background-image: url('https://images.unsplash.com/photo-1547394765-185e1e68f34e?auto=format&fit=crop&w=1800&q=85');
    }

    .hero-3 {
        background-image: url('https://images.unsplash.com/photo-1616588589676-62b3bd4ff6d2?auto=format&fit=crop&w=1800&q=85');
    }

    .hero-content {
        position: relative;
        z-index: 2;
        width: min(1180px, 92%);
        margin: 0 auto;
        color: #fff;
    }

    .hero-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 14px;
        padding: 8px 14px;
        border-radius: 999px;
        background: rgba(37, 99, 235, 0.25);
        border: 1px solid rgba(37, 99, 235, 0.5);
        color: #60a5fa;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: .8px;
        text-transform: uppercase;
    }

    .hero-title {
        max-width: 610px;
        font-size: clamp(42px, 5vw, 72px);
        line-height: .98;
        letter-spacing: -2px;
        margin-bottom: 20px;
        color: #fff;
    }

    .hero-desc {
        max-width: 530px;
        color: #cbd5e1;
        line-height: 1.7;
        font-size: 16px;
        margin-bottom: 28px;
    }

    .hero-btn {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 14px 26px;
        border: none;
        border-radius: 12px;
        background: #2563eb;
        color: #fff;
        text-decoration: none;
        font-weight: 800;
    }

    .hero-controls {
        position: absolute;
        z-index: 5;
        left: 50%;
        bottom: 26px;
        transform: translateX(-50%);
        display: flex;
        align-items: center;
        gap: 9px;
        background: rgba(0, 0, 0, 0.4);
        padding: 8px 14px;
        border-radius: 999px;
        backdrop-filter: blur(8px);
    }

    .hero-dot {
        width: 10px;
        height: 10px;
        border: 0;
        border-radius: 50%;
        background: rgba(255,255,255,.46);
        cursor: pointer;
    }

        .hero-dot.active {
            width: 28px;
            border-radius: 999px;
            background: #2563eb;
        }

    .hero-pause {
        margin-left: 8px;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        border: 1px solid rgba(255,255,255,.2);
        background: rgba(255,255,255,.1);
        color: #fff;
        cursor: pointer;
        display: grid;
        place-items: center;
        font-size: 11px;
    }

    /* SECTIONS (CHỮ ĐEN) */
    .section {
        width: min(1180px, 92%);
        margin: 0 auto;
        padding: 58px 0;
    }

    .section-heading {
        display: flex;
        justify-content: space-between;
        align-items: end;
        gap: 20px;
        margin-bottom: 26px;
    }

        .section-heading h2 {
            font-size: clamp(27px, 3vw, 38px);
            line-height: 1.1;
            margin-bottom: 6px;
            color: #111111; /* Chữ tiêu đề màu đen đậm */
            font-weight: 800;
        }

        .section-heading p {
            color: #4b5563; /* Chữ mô tả màu xám đậm */
            font-size: 14px;
            font-weight: 600;
        }

    .see-all {
        text-decoration: none;
        color: #2563eb;
        font-weight: 700;
        white-space: nowrap;
    }

        .see-all:hover {
            text-decoration: underline;
        }

    /* CATEGORY GRID (Thẻ nền trắng sáng, chữ đen) */
    .category-grid {
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        gap: 14px;
    }

    .category-card {
        position: relative;
        min-height: 150px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 14px;
        padding: 18px 10px;
        border: 1px solid #cbd5e1;
        border-radius: 16px;
        background: rgba(255, 255, 255, 0.92); /* Nền trắng mờ */
        backdrop-filter: blur(8px);
        text-decoration: none;
        color: #111; /* Chữ đen */
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
        transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
    }

        .category-card:hover {
            transform: translateY(-5px);
            border-color: #2563eb;
            box-shadow: 0 10px 22px rgba(37, 99, 235, 0.2);
        }

    .category-icon {
        width: 56px;
        height: 56px;
        border-radius: 15px;
        display: grid;
        place-items: center;
        background: #eff6ff;
        color: #2563eb;
        font-size: 23px;
    }

    .category-card:hover .category-icon {
        background: #2563eb;
        color: #fff;
    }

    .category-card span {
        text-align: center;
        font-size: 14px;
        font-weight: 750;
        color: #1e293b;
    }

    /* BENEFITS (Thẻ nền trắng sáng, chữ đen) */
    .benefit-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 14px;
    }

    .benefit-card {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 20px;
        border-radius: 16px;
        background: rgba(255, 255, 255, 0.92);
        backdrop-filter: blur(8px);
        border: 1px solid #cbd5e1;
        box-shadow: 0 4px 14px rgba(0,0,0,0.08);
    }

    .benefit-icon {
        flex: 0 0 46px;
        width: 46px;
        height: 46px;
        border-radius: 13px;
        display: grid;
        place-items: center;
        background: #eff6ff;
        color: #2563eb;
        font-size: 18px;
    }

    .benefit-card h3 {
        font-size: 15px;
        margin-bottom: 4px;
        color: #111;
        font-weight: 700;
    }

    .benefit-card p {
        color: #4b5563;
        font-size: 13px;
        line-height: 1.5;
    }

    .chat-btn {
        position: fixed;
        right: 24px;
        bottom: 24px;
        z-index: 20;
        width: 58px;
        height: 58px;
        border: 0;
        border-radius: 50%;
        background: #2563eb;
        color: #fff;
        display: grid;
        place-items: center;
        font-size: 23px;
        cursor: pointer;
        box-shadow: 0 12px 28px rgba(37, 99, 235, .4);
    }

        .chat-btn:hover {
            transform: scale(1.08);
            background: #1d4ed8;
        }
</style>

<div class="home-wrap">
    <!-- BANNER -->
    <section class="hero" aria-label="Banner quảng cáo">
        <article class="hero-slide hero-1 active">
            <div class="hero-content">
                <div class="hero-eyebrow">
                    <i class="fa-solid fa-bolt"></i> Gaming gear mới
                </div>
                <h1 class="hero-title">Lubu Gear<br />Pro Series 2.0</h1>
                <p class="hero-desc">
                    Thiết bị gaming không dây siêu nhẹ, thiết kế dành cho game thủ cần tốc độ,
                    độ chính xác và cảm giác cầm nắm thoải mái nhất.
                </p>
                <a href="@Url.Action("ProductList", "Home1", new { area = "Customer",  })" class="hero-btn">
                    Xem thêm <i class="fa-solid fa-arrow-right"></i>
                </a>
            </div>
        </article>

        <article class="hero-slide hero-2">
            <div class="hero-content">
                <div class="hero-eyebrow">
                    <i class="fa-solid fa-gamepad"></i> Gaming setup
                </div>
                <h2 class="hero-title">Nâng cấp<br />góc game của bạn</h2>
                <p class="hero-desc">
                    Từ chuột, bàn phím đến tai nghe và mousepad — chọn đúng gear tại Lubu Store để setup
                    vừa đẹp vừa chiến.
                </p>
                <a href="@Url.Action("ProductList", "Home1", new { area = "Customer", })" class="hero-btn">
                    Khám phá ngay <i class="fa-solid fa-arrow-right"></i>
                </a>
            </div>
        </article>

        <article class="hero-slide hero-3">
            <div class="hero-content">
                <div class="hero-eyebrow">
                    <i class="fa-solid fa-star"></i> Best seller
                </div>
                <h2 class="hero-title">Gear xịn<br />chơi game đã</h2>
                <p class="hero-desc">
                    Những sản phẩm được nhiều game thủ lựa chọn, nổi bật về hiệu năng và thiết kế tại Lubu Store.
                </p>
                <a href="@Url.Action("ProductList", "Home1", new { area = "Customer" })" class="hero-btn">
                    Xem sản phẩm <i class="fa-solid fa-arrow-right"></i>
                </a>
            </div>
        </article>

        <div class="hero-controls">
            <button class="hero-dot active" data-slide="0" aria-label="Banner 1"></button>
            <button class="hero-dot" data-slide="1" aria-label="Banner 2"></button>
            <button class="hero-dot" data-slide="2" aria-label="Banner 3"></button>
            <button class="hero-pause" id="heroPause" aria-label="Tạm dừng banner">
                <i class="fa-solid fa-pause"></i>
            </button>
        </div>
    </section>

    <!-- DANH MỤC -->
    <section class="section" id="categories">
        <div class="section-heading" style="margin-bottom: 20px;">
            <div>
                <h2>Danh mục chính</h2>
                <p>Chọn nhanh nhóm sản phẩm bạn đang tìm kiếm</p>
            </div>
            <a class="see-all" href="@Url.Action("ProductList", "Home1", new { area = "Customer" })">Xem tất cả <i class="fa-solid fa-arrow-right"></i></a>
        </div>

        <div class="category-grid">
            <a href="@Url.Action("ProductList", "Home1", new { area = "Customer", categoryId = 1 })" class="category-card">
                <div class="category-icon"><i class="fa-solid fa-computer-mouse"></i></div>
                <span>Chuột Gaming</span>
            </a>
            <a href="@Url.Action("ProductList", "Home1", new { area = "Customer", categoryId = 2 })" class="category-card">
                <div class="category-icon"><i class="fa-regular fa-keyboard"></i></div>
                <span>Bàn phím</span>
            </a>
            <a href="@Url.Action("ProductList", "Home1", new { area = "Customer", categoryId = 3 })" class="category-card">
                <div class="category-icon"><i class="fa-solid fa-headphones"></i></div>
                <span>Tai nghe</span>
            </a>
            <a href="@Url.Action("ProductList", "Home1", new { area = "Customer", categoryId = 4 })" class="category-card">
                <div class="category-icon"><i class="fa-solid fa-mouse"></i></div>
                <span>Mousepad</span>
            </a>
            <a href="@Url.Action("ProductList", "Home1", new { area = "Customer", categoryId = 5 })" class="category-card">
                <div class="category-icon"><i class="fa-solid fa-desktop"></i></div>
                <span>Màn hình</span>
            </a>
            <a href="@Url.Action("ProductList", "Home1", new { area = "Customer", categoryId = 6 })" class="category-card">
                <div class="category-icon"><i class="fa-solid fa-keyboard"></i></div>
                <span>Phụ kiện</span>
            </a>
        </div>
    </section>

    <!-- 1. GỌI PARTIAL VIEW SẢN PHẨM NỔI BẬT -->
    <div id="best-seller" style="padding: 10px 0;">
        <div class="section" style="padding: 20px 0;">
            @Html.Partial("_PVFeatureProduct", Model)
        </div>
    </div>

    <!-- 2. GỌI PARTIAL VIEW SẢN PHẨM MỚI -->
    <div style="padding: 10px 0;">
        <div class="section" style="padding: 20px 0;">
            @Html.Partial("_PVNewProduct", Model)
        </div>
    </div>

    <!-- DỊCH VỤ -->
    <section class="section" style="padding-bottom: 60px;">
        <div class="benefit-grid">
            <article class="benefit-card">
                <div class="benefit-icon"><i class="fa-solid fa-truck-fast"></i></div>
                <div>
                    <h3>Giao hàng nhanh</h3>
                    <p>Đóng gói kỹ và hỗ trợ giao hàng toàn quốc.</p>
                </div>
            </article>
            <article class="benefit-card">
                <div class="benefit-icon"><i class="fa-solid fa-shield-halved"></i></div>
                <div>
                    <h3>Chính hãng & bảo hành</h3>
                    <p>Thông tin sản phẩm rõ ràng, hỗ trợ sau mua.</p>
                </div>
            </article>
            <article class="benefit-card">
                <div class="benefit-icon"><i class="fa-solid fa-headset"></i></div>
                <div>
                    <h3>Hỗ trợ game thủ</h3>
                    <p>Tư vấn gear phù hợp theo nhu cầu và ngân sách.</p>
                </div>
            </article>
        </div>
    </section>
</div>

<!-- NÚT CHAT -->
<button class="chat-btn" type="button" aria-label="Mở hỗ trợ chat">
    <i class="fa-solid fa-message"></i>
</button>

@section Scripts {
    <script>
        (function () {
            const slides = Array.from(document.querySelectorAll('.hero-slide'));
            const dots = Array.from(document.querySelectorAll('.hero-dot'));
            const pauseButton = document.getElementById('heroPause');
            if (!slides.length) return;

            let current = 0;
            let paused = false;
            let timer;

            function showSlide(index) {
                current = (index + slides.length) % slides.length;
                slides.forEach((slide, i) => slide.classList.toggle('active', i === current));
                dots.forEach((dot, i) => dot.classList.toggle('active', i === current));
            }

            function startTimer() {
                clearInterval(timer);
                if (!paused) {
                    timer = setInterval(() => showSlide(current + 1), 5000);
                }
            }

            dots.forEach(dot => {
                dot.addEventListener('click', () => {
                    showSlide(Number(dot.dataset.slide));
                    startTimer();
                });
            });

            pauseButton?.addEventListener('click', () => {
                paused = !paused;
                pauseButton.innerHTML = paused
                    ? '<i class="fa-solid fa-play"></i>'
                    : '<i class="fa-solid fa-pause"></i>';
                startTimer();
            });

            showSlide(0);
            startTimer();
        })();
    </script>
}