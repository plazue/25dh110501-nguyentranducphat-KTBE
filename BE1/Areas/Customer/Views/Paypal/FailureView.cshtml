@{
    ViewBag.Title = "Thanh toán thất bại";
    Layout = "~/Areas/Customer/Views/Shared/_CustomerLayout.cshtml";
}

<div style="max-width: 700px; margin: 40px auto; background: #fff; border-radius: 12px; padding: 40px; box-shadow: 0 4px 16px rgba(0,0,0,0.05); text-align: center;">
    <div style="font-size: 55px; color: #dc2626; margin-bottom: 15px;">
        <i class="fa-solid fa-circle-xmark"></i>
    </div>
    <h1 style="font-size: 24px; font-weight: 750; color: #111; margin-bottom: 8px;">Thanh toán không thành công!</h1>
    <p style="color: #6b7280; font-size: 14px; margin-bottom: 25px;">Đã có lỗi xảy ra hoặc bạn đã hủy quá trình thanh toán qua PayPal. Đơn hàng chưa được ghi nhận.</p>

    <div style="display: flex; gap: 15px; justify-content: center; margin-top: 30px;">
        <a href="@Url.Action("Index", "Cart", new { area = "Customer" })" style="background: #2563eb; color: #fff; padding: 12px 24px; border-radius: 8px; text-decoration: none; font-weight: 700; font-size: 14px;">Quay lại giỏ hàng</a>
        <a href="@Url.Action("ProductList", "Home1", new { area = "Customer" })" style="background: #f3f4f6; color: #374151; padding: 12px 24px; border-radius: 8px; text-decoration: none; font-weight: 700; font-size: 14px; border: 1px solid #d1d5db;">Tiếp tục mua sắm</a>
    </div>
</div>